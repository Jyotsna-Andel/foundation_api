# Copy to `.env` (same folder) and adjust. `.env` is git-ignored; this template is committed.
# Never put real passwords or API keys in this file.

# PostgreSQL connection used by the app (PrismaService) and the Prisma CLI.
# Current local setup: `npx prisma dev` (run from api/). These are its default local credentials.
# Will change to the Docker Compose database (see docs/adr/0005-local-database.md).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Scratch database used only by `prisma migrate dev` to verify migrations.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# HTTP port for the API (optional, defaults to 3000).
PORT=3000
