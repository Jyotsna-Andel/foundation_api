# Copy to `.env` (same folder) and adjust. `.env` is git-ignored; this template is committed.
# Never put real passwords or API keys in this file.

# PostgreSQL connection used by the app (PrismaService) and the Prisma CLI.
# Matches the local Docker Compose database (docker-compose.yml at the repo root).
# Local development credentials only.
DATABASE_URL="postgresql://library:library@localhost:5432/library_dev"

# No SHADOW_DATABASE_URL needed: `prisma migrate dev` creates and drops its own
# temporary shadow database. Set it only if your DB user cannot create databases.

# HTTP port for the API (optional, defaults to 3000).
PORT=3000
